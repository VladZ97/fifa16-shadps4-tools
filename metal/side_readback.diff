+void TextureCache::DownloadImagesForCpuRead(VAddr addr, size_t size, bool for_write) {
+    boost::container::small_vector<std::pair<ImageId, bool>, 4> ids;
+    boost::container::small_vector<ImageId, 4> async_ids;
+    {
+        std::unique_lock lk{download_images_mutex};
+        if (ondemand_images.empty()) {
+            return;
+        }
+        // Protection is per page, so a fault on a page shared with an image must resolve the
+        // image even if the accessed bytes lie outside it (e.g. shader code next to a texture).
+        const auto pages_start = PageManager::GetPageAddr(addr);
+        const auto pages_end = PageManager::GetNextPageAddr(addr + size - 1);
+        ForEachImageInRegion(pages_start, pages_end - pages_start, [&](ImageId image_id, Image& image) {
+            if (ondemand_images.contains(image_id)) {
+                ids.emplace_back(image_id, True(image.flags & ImageFlagBits::GpuModified));
+            }
+        });
+        // for a CPU write: images whose bytes the write does not touch can be written back
+        // asynchronously (the game writes a neighbour in the same page every frame)
+        if (for_write) {
+            for (auto& [id, modified] : ids) {
+                const auto& im = slot_images[id];
+                const bool touches = addr < im.info.guest_address + im.info.guest_size &&
+                                     im.info.guest_address < addr + size;
+                // an image the CPU has read before may be read again right after this write:
+                // keep the synchronous download for it (a stale read gave glowing players)
+                const bool cpu_reads_it = cpu_read_images.contains(im.info.guest_address);
+                if (!touches && modified && !cpu_reads_it) {
+                    modified = false;            // not a sync download
+                    async_ids.push_back(id);     // but an async one
+                    async_written_images.insert(im.info.guest_address);
+                }
+            }
+        } else {
+            for (const auto& [id, _] : ids) {
+                const VAddr a = slot_images[id].info.guest_address;
+                if (cpu_read_images.insert(a).second && async_written_images.contains(a)) {
+                    // first CPU read of an image that already took the async path: the read may
+                    // have seen a stale copy (this is the window the read-history rule cannot close)
+                    LOG_WARNING(Render_Vulkan, "ONDEMAND RACE-RISK first read after async write-back addr={:#x}", a);
+                }
+            }
+        }
+        for (const auto& [id, _] : ids) {
+            ondemand_images.erase(id);
+        }
+    }
+    for (const auto& [id, modified] : ids) {
+        static const bool log_images = std::getenv("SHAD_LOG_IMAGES") != nullptr;
+        if (log_images) {
+            const auto& im = slot_images[id];
+            LOG_INFO(Render_Vulkan, "ONDEMAND download addr={:#x} {}x{} fmt={} modified={}",
+                     im.info.guest_address, im.info.size.width, im.info.size.height,
+                     vk::to_string(im.info.pixel_format), modified);
+        }
+        if (modified) {
+            DownloadImageMemory(id, DownloadMemoryFlags::Sync | DownloadMemoryFlags::DiscardBufferCache);
+        }
+    }
+    for (const auto id : async_ids) {
+        static std::atomic<u64> n{0};
+        if ((++n % 500) == 0) {
+            LOG_INFO(Render_Vulkan, "ONDEMAND async write-back #{} (neighbour CPU write)", n.load());
+        }
+        DownloadImageMemory(id, DownloadMemoryFlags::DiscardBufferCache);
+    }
+    for (const auto& [id, _] : ids) {
+        // Always lift the read protection of the whole image, so a page that the download
+        // did not cover (e.g. mip tail) cannot fault forever.
+        const auto& image = slot_images[id];
+        std::unique_lock lk{download_images_mutex};
+        ProtectForCpuRead(image.info.guest_address, image.info.guest_size, false);
+    }
+}
+
+void TextureCache::ForgetOndemandImage(ImageId image_id) {
+    std::unique_lock lk{download_images_mutex};
+    if (ondemand_images.erase(image_id)) {
+        const auto& image = slot_images[image_id];
+        ProtectForCpuRead(image.info.guest_address, image.info.guest_size, false);
+    }
+}
