diff --git a/src/core/file_sys/dir_index.cpp b/src/core/file_sys/dir_index.cpp
new file mode 100644
index 00000000..4d413211
--- /dev/null
+++ b/src/core/file_sys/dir_index.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <system_error>
+#include "common/string_util.h"
+#include "core/file_sys/dir_index.h"
+
+namespace Core::FileSys {
+
+DirIndex& DirIndex::Instance() {
+    static DirIndex instance;
+    return instance;
+}
+
+const DirIndex::Listing& DirIndex::Get(const std::filesystem::path& dir) {
+    const auto key = dir.string();
+    if (const auto it = dirs.find(key); it != dirs.end()) {
+        return it->second;
+    }
+    Listing listing{};
+    std::error_code ec;
+    if (std::filesystem::is_directory(dir, ec)) {
+        listing.exists = true;
+        for (const auto& entry : std::filesystem::directory_iterator(dir, ec)) {
+            const auto name = entry.path().filename().string();
+            listing.names.emplace(Common::ToLower(name), name);
+        }
+    }
+    return dirs.emplace(key, std::move(listing)).first->second;
+}
+
+std::optional<std::filesystem::path> DirIndex::Lookup(const std::filesystem::path& dir,
+                                                      std::string_view name) {
+    std::scoped_lock lk{mutex};
+    const auto& listing = Get(dir);
+    if (!listing.exists) {
+        return std::nullopt;
+    }
+    const auto it = listing.names.find(Common::ToLower(std::string{name}));
+    if (it == listing.names.end()) {
+        return std::nullopt;
+    }
+    return std::filesystem::path{it->second};
+}
+
+void DirIndex::Invalidate(const std::filesystem::path& dir) {
+    std::scoped_lock lk{mutex};
+    dirs.erase(dir.string());
+}
+
+} // namespace Core::FileSys
diff --git a/src/core/file_sys/dir_index.h b/src/core/file_sys/dir_index.h
new file mode 100644
index 00000000..dfa266a1
--- /dev/null
+++ b/src/core/file_sys/dir_index.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Local change (FIFA 16 on macOS): per-directory name index so case-insensitive lookups of missing
+// files cost one hash lookup instead of a stat plus a full directory listing per probe. Games that
+// probe dozens of candidate asset names per object spent most of their loading time in those scans.
+#pragma once
+
+#include <filesystem>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+
+namespace Core::FileSys {
+
+class DirIndex {
+public:
+    static DirIndex& Instance();
+
+    /// Actual on-disk name of `name` inside `dir` (case-insensitive), or nullopt if absent.
+    std::optional<std::filesystem::path> Lookup(const std::filesystem::path& dir,
+                                                std::string_view name);
+    /// Drop the cached listing of `dir` (call after creating/removing/renaming entries in it).
+    void Invalidate(const std::filesystem::path& dir);
+    void InvalidateParent(const std::filesystem::path& path) {
+        Invalidate(path.parent_path());
+    }
+
+private:
+    struct Listing {
+        bool exists{};
+        std::unordered_map<std::string, std::string> names; // lowercase -> actual
+    };
+    const Listing& Get(const std::filesystem::path& dir);
+
+    std::mutex mutex;
+    std::unordered_map<std::string, Listing> dirs;
+};
+
+} // namespace Core::FileSys
